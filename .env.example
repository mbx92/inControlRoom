APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_SEND_DEFAULT_PII=false
SENTRY_SEND_LOCAL=false
SENTRY_URL=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
GLITCHTIP_SECURITY_ENDPOINT=
GLITCHTIP_CSP_REPORT_ONLY=true
GLITCHTIP_CSP_POLICY="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: http: ws: wss:; media-src 'self' data: blob: https:;"

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=incontrolroom
DB_USERNAME=postgres
DB_PASSWORD=

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Super Admin"
AUTO_RUN_SEED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO (S3-compatible) for Windows agent installer distribution
# MINIO_ENDPOINT must be the S3 API endpoint, NOT a public CDN URL.
# Example API endpoint: https://minio.internal:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE_ENDPOINT=true
# Public CDN/base URL for direct bucket download links shown in Settings
MINIO_PUBLIC_URL=
# Optional full override for the installer download URL
# AGENT_INSTALLER_PUBLIC_URL=
AGENT_INSTALLER_DISK=minio
AGENT_INSTALLER_OBJECT_KEY=agents/InfraControl.Agent.Setup.exe
AGENT_INSTALLER_FILENAME=InfraControl.Agent.Setup.exe
AGENT_INSTALLER_VERSION=1.0.0

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
VITE_SENTRY_RELEASE="${SENTRY_RELEASE}"
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_ENABLED=false
VITE_BUILD_SOURCEMAP=false
VITE_PROXMOX_CONSOLE_PROXY_URL=
PROXMOX_CONSOLE_PROXY_HOST=127.0.0.1
PROXMOX_CONSOLE_PROXY_PORT=8077
VITE_SSH_TERMINAL_PROXY_URL=
SSH_TERMINAL_PROXY_URL=
SSH_TERMINAL_PROXY_HOST=127.0.0.1
SSH_TERMINAL_PROXY_PORT=8078
SSH_TERMINAL_PROXY_HEALTH_URL=
SSH_TERMINAL_PROXY_MANAGED_EXTERNALLY=false
VITE_VNC_PROXY_URL=
VNC_PROXY_URL=
VNC_PROXY_HOST=127.0.0.1
VNC_PROXY_PORT=8079
