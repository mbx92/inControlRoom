<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>InfraControl.Agent.Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefaultItemExcludes>$(DefaultItemExcludes);Package.wxs</DefaultItemExcludes>
    <DefineConstants>MsiPath=$(MsiPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" />
  </ItemGroup>
</Project>
